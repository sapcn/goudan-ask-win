# xiaoer-ask Windows 版环境配置
# 复制本文件为 .env 并填入你自己的 key
#
# 智谱 API key 申请：https://bigmodel.cn/apikey/platform

ZHIPU_API_KEY=your-zhipu-api-key-here

# 模型选择：
#   glm-5.3-flash —— Coding Plan 套餐模型（原生多模态能看图，订阅内用）
#   glm-4v-flash —— 免费视觉模型（能看截图，零成本，推荐起步用）
#   glm-5v-turbo / glm-4.5v —— 付费视觉模型（需账户按量余额）
XIAOER_MODEL=glm-5.3-flash

# 接口风格（跟着 key 的类型走）：
#   openai    —— 标准 API key（按量付费），走 open.bigmodel.cn/api/paas/v4
#   anthropic —— Coding Plan 套餐 key（订阅制），走 api/anthropic 端点，
#                模型用 glm-5.3 / glm-5.3-flash
XIAOER_API_STYLE=anthropic

# AI 对你的称呼（会体现在提示词里）
XIAOER_USER_NAME=AI牧民

# 全局热键（修饰键+键位）。可选修饰键：alt / ctrl / shift / windows
XIAOER_HOTKEY_MOD=alt
XIAOER_HOTKEY_KEY=q
